## 2. Production Architecture Design via ZenML Pipeline

[ZenML](https://docs.zenml.io/) is an extensible, open-source MLOps framework used to write reproducible Machine Learning pipelines. It decouples infrastructure configuration from your code execution logic using `@step` and `@pipeline` decorators.

### Pipeline Component Layout Block Diagram
```
  [data_loader] ----> [data_preprocessor] ----> [model_evaluator]
                            |
                            +------> [model_trainer] (GDA, LRA, Naive Bayes)
```

---

## 3. Modular ZenML Implementation Code

The production pipeline code below defines data ingesting, multi-model parallel training, evaluation, and asset tracking steps.

```python
import numpy as np
from typing import Dict, Tuple
from zenml import step, pipeline, artifact_utils

# =====================================================================
# MODEL MATHEMATICAL SOURCE IMPLEMENTATIONS (Numpy Matrix Vector Ops)
# =====================================================================

class GaussianDiscriminantAnalysis:
    def fit(self, X: np.ndarray, y: np.ndarray):
        self.phi = np.mean(y)
        X_0, X_1 = X[y == 0], X[y == 1]
        self.mu_0, self.mu_1 = np.mean(X_0, axis=0), np.mean(X_1, axis=0)
        diff_0, diff_1 = X_0 - self.mu_0, X_1 - self.mu_1
        self.sigma = (np.dot(diff_0.T, diff_0) + np.dot(diff_1.T, diff_1)) / len(y)
        
    def _pdf(self, X: np.ndarray, mu: np.ndarray, sigma: np.ndarray) -> np.ndarray:
        n = len(mu)
        det = np.linalg.det(sigma)
        inv = np.linalg.inv(sigma)
        diff = X - mu
        exponent = -0.5 * np.sum(np.dot(diff, inv) * diff, axis=1)
        return (1.0 / (((2 * np.pi) ** (n / 2)) * np.sqrt(det))) * np.exp(exponent)

    def predict_proba(self, X: np.ndarray) -> np.ndarray:
        p0 = self._pdf(X, self.mu_0, self.sigma) * (1 - self.phi)
        p1 = self._pdf(X, self.mu_1, self.phi) * self.phi
        return p1 / (p0 + p1)

class LogisticRegressionModel:
    def __init__(self, lr: float = 0.05, iterations: int = 1000):
        self.lr = lr
        self.iterations = iterations
        
    def fit(self, X: np.ndarray, y: np.ndarray):
        m, n = X.shape
        self.w, self.b = np.zeros(n), 0.0
        for _ in range(self.iterations):
            y_pred = 1 / (1 + np.exp(-(np.dot(X, self.w) + self.b)))
            dw = (1 / m) * np.dot(X.T, (y_pred - y))
            db = (1 / m) * np.sum(y_pred - y)
            self.w -= self.lr * dw
            self.b -= self.lr * db

    def predict_proba(self, X: np.ndarray) -> np.ndarray:
        return 1 / (1 + np.exp(-(np.dot(X, self.w) + self.b)))

class GaussianNaiveBayes:
    def fit(self, X: np.ndarray, y: np.ndarray):
        self.classes = np.unique(y)
        self.priors = np.array([np.mean(y == c) for c in self.classes])
        self.means = np.array([np.mean(X[y == c], axis=0) for c in self.classes])
        self.vars = np.array([np.var(X[y == c], axis=0) + 1e-9 for c in self.classes])

    def predict_proba(self, X: np.ndarray) -> np.ndarray:
        probs = []
        for x in X:
            class_probs = []
            for idx, c in enumerate(self.classes):
                prior = np.log(self.priors[idx])
                likelihood = -0.5 * np.sum(np.log(2 * np.pi * self.vars[idx])) - 0.5 * np.sum(((x - self.means[idx]) ** 2) / self.vars[idx])
                class_probs.append(prior + likelihood)
            exp_probs = np.exp(class_probs - np.max(class_probs))
            probs.append(exp_probs / np.sum(exp_probs))
        return np.array(probs)[:, 1]

# =====================================================================
# ZENML PIPELINE STEPS DEFINITION
# =====================================================================

@step
def data_loader() -> Tuple[np.ndarray, np.ndarray]:
    """Generates clinical target data artifacts."""
    np.random.seed(42)
    X_healthy = np.random.multivariate_normal([160, 190], [[100, -10], [-10, 120]], 100)
    X_disease = np.random.multivariate_normal([135, 260], [[110, -5], [-5, 150]], 100)
    X = np.vstack((X_healthy, X_disease))
    y = np.concatenate((np.zeros(100), np.ones(100)))
    return X, y

@step
def data_preprocessor(X: np.ndarray, y: np.ndarray) -> Tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
    """Performs Train/Test partitioning and feature scaling."""
    indices = np.arange(X.shape[0])
    np.random.shuffle(indices)
    X, y = X[indices], y[indices]
    
    split_idx = int(0.8 * len(X))
    X_train, X_test = X[:split_idx], X[split_idx:]
    y_train, y_test = y[:split_idx], y[split_idx:]
    
    # Feature Standardization mapping
    mean, std = X_train.mean(axis=0), X_train.std(axis=0)
    X_train_scaled = (X_train - mean) / std
    X_test_scaled = (X_test - mean) / std
    
    return X_train_scaled, X_test_scaled, y_train, y_test

@step
def model_trainer(X_train: np.ndarray, y_train: np.ndarray) -> Dict[str, object]:
    """Trains models across discrete probability algorithms."""
    gda = GaussianDiscriminantAnalysis()
    gda.fit(X_train, y_train)
    
    lra = LogisticRegressionModel(lr=0.1, iterations=1000)
    lra.fit(X_train, y_train)
    
    nb = GaussianNaiveBayes()
    nb.fit(X_train, y_train)
    
    return {"gda": gda, "lra": lra, "naive_bayes": nb}

@step
def model_evaluator(models: Dict[str, object], X_test: np.ndarray, y_test: np.ndarray) -> Dict[str, float]:
    """Computes analytical test matrices across estimators."""
    results = {}
    for name, model in models.items():
        probs = model.predict_proba(X_test)
        preds = (probs >= 0.5).astype(int)
        acc = float(np.mean(preds == y_test) * 100)
        results[name] = acc
        print(f"Evaluated Model [{name.upper()}] Accuracy: {acc:.2f}%")
    return results

# =====================================================================
# ZENML PIPELINE GRAPH DEPLOYMENT
# =====================================================================

@pipeline
def probabilistic_classification_pipeline():
    """Orchestrates steps end-to-end."""
    X, y = data_loader()
    X_train, X_test, y_train, y_test = data_preprocessor(X, y)
    trained_models = model_trainer(X_train, y_train)
    model_evaluator(trained_models, X_test, y_test)

if __name__ == "__main__":
    probabilistic_classification_pipeline()
```

